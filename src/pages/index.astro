---
import Brand from "../components/Brand.astro";
import SessionDemo from "../components/SessionDemo.astro";
import TerminalDemo from "../components/TerminalDemo.astro";
import { workshop_projects } from "../data/projects";
import "../styles/global.css";
import "../styles/home.css";

const site_title = "Tokn AI — Building the wheels for RSI";
const site_description = "Open-source wheels for recursive self-improvement (RSI): agent sessions, terminal control, model routing, usage reports, tokenization, and model research.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={site_description} />
    <meta name="theme-color" content="#fcfbf8" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="canonical" href="https://tokn-ai.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tokn AI" />
    <meta property="og:title" content={site_title} />
    <meta property="og:description" content={site_description} />
    <meta property="og:url" content="https://tokn-ai.dev/" />
    <meta property="og:image" content="https://tokn-ai.dev/og.png" />
    <meta property="og:image:alt" content="Tokn AI. Building the wheels. For RSI. Open-source building blocks for recursive self-improvement." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site_title} />
    <meta name="twitter:description" content={site_description} />
    <meta name="twitter:image" content="https://tokn-ai.dev/og.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{site_title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <div class="shell header-inner">
        <Brand />
        <nav aria-label="Main navigation">
          <a href="#tools">The tools</a>
          <a href="#workshop">The workshop</a>
          <a class="nav-github" href="https://github.com/tokn-ai">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <svg class="hero-thread" viewBox="0 0 1440 670" fill="none" aria-hidden="true">
          <path class="thread-plum" pathLength="1" d="M-65 180C145 15 210 80 171 235S-24 460 131 487C272 512 228 319 147 391S230 657 460 587" />
          <path class="thread-teal" pathLength="1" d="M972 605C1120 637 1362 612 1260 434S1094 394 1199 453S1485 343 1450 202" />
        </svg>
        <div class="shell hero-inner">
          <p class="eyebrow hero-eyebrow"><span class="little-star" aria-hidden="true">✳</span> Agents · tools · models</p>
          <h1 id="hero-title"><span class="hero-line hero-line-intro">Building the <em class="hero-emphasis">wheels.</em></span> <span class="hero-line hero-line-context">For <em class="hero-emphasis-teal">RSI.</em></span></h1>
          <p class="hero-description">Open-source building blocks for recursive self-improvement.<br class="desktop-break" /> For AI to inspect its work, run experiments, and improve its own systems.</p>
          <div class="hero-actions">
            <a class="button button-plum" href="#tools">Explore the tools <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="https://github.com/tokn-ai">View the source <span aria-hidden="true">↗</span></a>
          </div>
          <a class="floating-note note-session" href="#tokn-session">
            <span class="note-icon" aria-hidden="true">↳</span>
            <span><small>tokn-session</small><strong>Run &amp; resume <br />agents</strong></span>
            <span class="note-check" aria-hidden="true">✓</span>
          </a>
          <a class="floating-note note-terminal" href="#ctl">
            <span class="note-icon" aria-hidden="true">&gt;_</span>
            <span><small>ctl</small><strong>Control shells <br />&amp; tasks</strong></span>
            <span class="running-dot" aria-hidden="true"></span>
          </a>
          <div class="hero-bottom">
            <span>Start with tokn-session and ctl.</span>
            <a href="#tools"><span aria-hidden="true">↓</span> Take a look around</a>
            <button class="motion-toggle" type="button" data-motion-toggle hidden aria-pressed="false">Pause motion <span aria-hidden="true">Ⅱ</span></button>
          </div>
        </div>
      </section>
      <div id="tools" class="tools">
        <section class="session-section shell" id="tokn-session" aria-labelledby="session-title">
          <div class="section-topline"><span>Run agents and inspect their work</span><span class="topline-doodle" aria-hidden="true">↶</span></div>
          <div class="product-story session-story">
            <div class="story-copy" data-reveal>
              <div class="product-heading"><span class="product-name">tokn-session</span><span class="development">In development</span></div>
              <h2 id="session-title">Run agents. <br /><em>Keep the <br />context.</em></h2>
              <p>Start and continue agent sessions with supported runtimes. Follow live work, browse histories, and inspect recorded tool steps across providers and paired machines.</p>
              <ul class="feature-list">
                <li>Create and continue supported agent sessions</li>
                <li>Search session titles and previews</li>
                <li>Use local and paired machines</li>
              </ul>
              <a class="text-link" href="https://github.com/tokn-ai/tokn-session">Explore tokn-session <span aria-hidden="true">↗</span></a>
              <p class="small-note">CLI, desktop + web. Live controls vary by provider.</p>
            </div>
            <div class="demo-scene session-scene" data-reveal>
              <p class="handwritten demo-hint">Try finding “keyboard” <span aria-hidden="true">↴</span></p>
              <SessionDemo />
              <p class="source-line"><span>Reads histories from</span> Codex · Pi · OpenCode · ZCode · WorkBuddy · DSH</p>
            </div>
          </div>
        </section>
        <section class="terminal-section" id="ctl" aria-labelledby="terminal-title">
          <div class="shell">
            <div class="section-topline"><span>Give the next experiment a place to run</span><span class="topline-doodle" aria-hidden="true">↳</span></div>
            <div class="product-story terminal-story">
              <div class="demo-scene terminal-scene" data-reveal>
                <p class="handwritten demo-hint">Go on. Disconnect. <span aria-hidden="true">↴</span></p>
                <TerminalDemo />
              </div>
              <div class="story-copy" data-reveal>
                <div class="product-heading"><span class="product-name">ctl</span><span class="development">In development</span></div>
                <h2 id="terminal-title">More control. <br /><em>From your CLI.</em></h2>
                <p>Control persistent shells, managed tasks, file copies, and port forwards across local and SSH hosts. Bundled skills help agents use the CLI, too.</p>
                <ul class="feature-list">
                  <li>Persistent sessions and split panes</li>
                  <li>Reusable tasks, status, and logs</li>
                  <li>File copies, port forwarding, and host control</li>
                </ul>
                <a class="text-link" href="https://github.com/tokn-ai/ctl">Explore ctl <span aria-hidden="true">↗</span></a>
                <p class="small-note">CLI control + desktop terminal access. Built around ctmux.</p>
              </div>
            </div>
            <div class="break-note" aria-hidden="true"><span>✳</span> room for a coffee break</div>
          </div>
        </section>
      </div>
      <section class="workshop-section shell" id="workshop" aria-labelledby="workshop-title">
        <div class="workshop-intro" data-reveal>
          <p class="eyebrow">More wheels for the loop</p>
          <h2 id="workshop-title">Build the next<br /><em>iteration.</em></h2>
          <p>Routing, usage reports, tokenization, and model experiments. Open components to study, adapt, and improve.</p>
        </div>
        <div class="workshop-grid">
          {workshop_projects.map((project) => (
            <article class={`workshop-project project-${project.id}`} id={project.id} data-reveal>
              <div class="project-top"><span class="project-symbol" aria-hidden="true">{project.symbol}</span><span class="project-status">{project.status}</span></div>
              <div class="project-title"><h3><a href={project.href}>{project.name}<span class="project-arrow" aria-hidden="true">↗</span></a></h3><span>{project.scope}</span></div>
              <p>{project.summary}</p>
              <div class="project-bottom"><span>{project.language}</span><span>{project.detail}</span></div>
            </article>
          ))}
        </div>
      </section>
      <section class="open-section" id="about" aria-labelledby="open-title">
        <div class="shell open-inner">
          <div class="open-art" aria-hidden="true">
            <span class="orbit-label orbit-label-top">one more iteration</span>
            <div class="logo-pebble"><img src="/logo-icon.svg" width="130" height="130" alt="" loading="lazy" /></div>
            <svg viewBox="0 0 300 300" fill="none"><ellipse cx="150" cy="150" rx="139" ry="82" transform="rotate(-32 150 150)" /><path d="m30 131-13 7 3-15" /></svg>
            <span class="orbit-label orbit-label-bottom">made to be opened</span>
          </div>
          <div class="open-copy" data-reveal>
            <p class="eyebrow">The loop we’re building for</p>
            <h2 id="open-title">Build. Measure.<br /><em>Improve.</em></h2>
            <p>Tokn AI builds the wheels for RSI: open-source tools for AI to inspect its work, run experiments, measure results, and improve its own tools and models.</p>
            <ol class="rsi-loop" aria-label="Recursive self-improvement research loop">
              <li>Inspect <span aria-hidden="true">→</span></li>
              <li>Experiment <span aria-hidden="true">→</span></li>
              <li>Measure <span aria-hidden="true">→</span></li>
              <li>Improve <span aria-hidden="true">↺</span></li>
            </ol>
            <a class="button button-plum" href="https://github.com/tokn-ai">Come explore on GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>
    <footer class="shell site-footer">
      <Brand />
      <p>Open-source wheels for RSI.</p>
      <a href="#top">Back to the top <span aria-hidden="true">↑</span></a>
      <span class="copyright">© {new Date().getFullYear()} Tokn AI</span>
    </footer>
    <script>
      const motionButton = document.querySelector<HTMLButtonElement>("[data-motion-toggle]");
      const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
      let motionPaused = motionPreference.matches;

      function setMotion(paused: boolean) {
        motionPaused = paused || motionPreference.matches;
        document.documentElement.dataset.motion = motionPaused ? "paused" : "playing";
        motionButton?.setAttribute("aria-pressed", String(motionPaused));
        if (motionButton) {
          motionButton.disabled = motionPreference.matches;
          motionButton.textContent = motionPreference.matches
            ? "Reduced motion · system preference"
            : motionPaused ? "Enable motion ▷" : "Pause motion Ⅱ";
        }
      }

      setMotion(motionPaused);
      if (motionButton) {
        motionButton.hidden = false;
        motionButton.addEventListener("click", () => setMotion(!motionPaused));
      }
      motionPreference.addEventListener("change", (event) => setMotion(event.matches));

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("has-arrived");
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.12 });
        document.querySelectorAll("[data-reveal]").forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
