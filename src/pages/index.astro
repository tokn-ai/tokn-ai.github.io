---
import Brand from "../components/Brand.astro";

const products = [
  {
    index: "01",
    name: "ffbpe",
    scope: "tokenization",
    status: "available",
    summary:
      "Fast and faithful byte-pair encoding for training exact tokenizers over large, multilingual corpora.",
    points: [
      "Python + Rust APIs",
      "Exact bounded-memory training",
      "Tiktoken-compatible encoding",
    ],
    language: "Rust / Python",
    href: "https://github.com/tokn-ai/ffbpe",
  },
  {
    index: "02",
    name: "flm.py",
    scope: "training",
    status: "research preview",
    summary:
      "A composable Python workspace for language-model research, training, reinforcement learning, and inference.",
    points: ["PyTorch foundations", "Reusable model modules", "Portable training experiments"],
    language: "Python",
    href: "https://github.com/tokn-ai/flm.py",
  },
  {
    index: "03",
    name: "tokn-router",
    scope: "inference",
    status: "in development",
    summary:
      "One local, OpenAI-compatible endpoint for supported coding plans and model providers.",
    points: ["Single Rust binary", "Streaming + account pools", "Local SQLite usage records"],
    language: "Rust",
    href: "https://github.com/agentic-rs/tokn",
  },
  {
    index: "04",
    name: "llm-tokei",
    scope: "observability",
    status: "available",
    summary:
      "Fast, local reports that show where your coding-agent tokens and estimated costs went.",
    points: ["Six agent sources", "Human tables + stable JSON", "No log uploads"],
    language: "Rust",
    href: "https://github.com/agentic-rs/llm-tokei",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Tokn AI is an open-source lab building reusable foundations for models and agents."
    />
    <meta name="theme-color" content="#fbfbfa" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="canonical" href="https://tokn-ai.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tokn AI" />
    <meta
      property="og:title"
      content="Tokn AI — Open foundations for models and agents"
    />
    <meta
      property="og:description"
      content="Reusable primitives, developer tools, and hosted services for the hard problems shared across AI products."
    />
    <meta property="og:url" content="https://tokn-ai.dev/" />
    <meta property="og:image" content="https://tokn-ai.dev/og.png" />
    <meta
      property="og:image:alt"
      content="Tokn AI — Open foundations for models and agents."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Tokn AI — Open foundations for models and agents"
    />
    <meta
      name="twitter:description"
      content="Reusable primitives, developer tools, and hosted services for the hard problems shared across AI products."
    />
    <meta name="twitter:image" content="https://tokn-ai.dev/og.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Tokn AI — Open foundations for models and agents</title>
  </head>

  <body>
    <header>
      <div class="container header-inner">
        <Brand />
        <nav aria-label="Primary navigation">
          <a href="#projects">Projects</a>
          <a href="#about">Principles</a>
          <a href="https://github.com/tokn-ai" target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero container">
        <div class="hero-copy">
          <p class="overline">
            <span class="status-dot"></span> Open source lab / models + agents
          </p>
          <h1>Open foundations for models and agents.</h1>
          <p class="lede">
            We build reusable primitives, developer tools, and hosted services
            for the hard problems shared across AI products.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">Explore projects</a>
            <a
              class="button secondary"
              href="https://github.com/tokn-ai"
              target="_blank"
              rel="noreferrer"
            >
              View source <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="stack-map" aria-label="Tokn AI open project stack">
          <div class="stack-map-header">
            <span>tokn-ai / open_stack</span>
            <span class="stack-map-dots" aria-hidden="true">● ● ●</span>
          </div>
          <div class="stack-map-body">
            <div class="stack-line">
              <span class="stack-node">corpus</span>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <strong>ffbpe</strong>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <span class="stack-result">tokens</span>
            </div>
            <div class="stack-line">
              <span class="stack-node">tokens</span>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <strong>flm.py</strong>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <span class="stack-result">model</span>
            </div>
            <div class="stack-line">
              <span class="stack-node">request</span>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <strong>tokn-router</strong>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <span class="stack-result">inference</span>
            </div>
            <div class="stack-line">
              <span class="stack-node">traces</span>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <strong>llm-tokei</strong>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <span class="stack-result">insight</span>
            </div>
          </div>
          <div class="stack-map-footer">
            <span>open core</span>
            <span>composable</span>
            <span>hosted when useful</span>
          </div>
        </div>
      </section>

      <section class="projects-section" id="projects">
        <div class="container">
          <div class="section-intro">
            <p class="overline">Open projects</p>
            <div>
              <h2>Four projects, one direction.</h2>
              <p>
                Each project tackles a difficult shared layer. Use one on its
                own, or combine them without adopting an entire stack.
              </p>
            </div>
          </div>

          <div class="project-list">
            {
              products.map((product) => (
                <article class="project">
                  <div class="project-meta">
                    <span>{product.index}</span>
                    <span>{product.scope}</span>
                  </div>
                  <div class="project-content">
                    <div>
                      <h3>{product.name}</h3>
                      <p>{product.summary}</p>
                    </div>
                    <ul>
                      {product.points.map((point) => <li>{point}</li>)}
                    </ul>
                  </div>
                  <div class="project-link">
                    <span class="project-status">{product.status}</span>
                    <a href={product.href} target="_blank" rel="noreferrer">
                      {product.language} <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="about container" id="about">
        <div class="section-intro">
          <p class="overline">About the lab</p>
          <div>
            <h2>The hard parts should be built once.</h2>
            <p>
              Most teams focus on the product they need to ship today. We focus
              on the foundations many products need, but few teams have the
              time to build well.
            </p>
          </div>
        </div>

        <div class="thesis">
          <p>We build the tools behind AI products.</p>
          <span>Open at the core. Local when preferred. Hosted when useful.</span>
        </div>

        <div class="values">
          <article>
            <code>01_reusable</code>
            <h3>Useful beyond one product.</h3>
            <p>
              We invest in clear boundaries and durable interfaces so the same
              foundation can support many different ideas.
            </p>
          </article>
          <article>
            <code>02_open</code>
            <h3>Understand every layer.</h3>
            <p>
              The core stays inspectable and replaceable. You should be able to
              see the tradeoffs and choose how each piece runs.
            </p>
          </article>
          <article>
            <code>03_adaptable</code>
            <h3>Built for a moving field.</h3>
            <p>
              Focused components adapt better than heavy abstractions. We keep
              the pieces small enough to evolve and strong enough to depend on.
            </p>
          </article>
        </div>

        <div class="toolchain" aria-label="Primary technologies">
          <span><strong>Rust</strong> / durable systems</span>
          <span><strong>TypeScript</strong> / product surfaces</span>
          <span><strong>Python</strong> / model research</span>
        </div>
      </section>

      <section class="cta">
        <div class="container cta-inner">
          <div>
            <p class="overline">Build with us</p>
            <h2>Build on open foundations.</h2>
            <p>
              Explore the projects, use what fits, and help improve the layers
              beneath the next generation of AI products.
            </p>
          </div>
          <div class="cta-actions">
            <a
              class="button cta-primary"
              href="https://github.com/tokn-ai"
              target="_blank"
              rel="noreferrer"
            >
              Explore GitHub <span aria-hidden="true">↗</span>
            </a>
            <a class="button cta-secondary" href="#projects">Browse projects</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <Brand />
        <p>Open foundations for models and agents.</p>
        <div class="footer-links">
          <a href="#projects">Projects</a>
          <a href="https://github.com/tokn-ai" target="_blank" rel="noreferrer">GitHub</a>
        </div>
        <span>© 2026</span>
      </div>
    </footer>

  </body>
</html>

<style>
  :root {
    --background: #fcfbf8;
    --surface: #ffffff;
    --surface-subtle: #f5f3ef;
    --text: #15172a;
    --text-secondary: #626575;
    --border: #e0dfdc;
    --border-strong: #bcbcc2;
    --blue: #5853d8;
    --blue-dark: #413cad;
    --cyan: #36ccec;
    --coral: #ff5a4e;
    --green: #2b9b62;
    --terminal: #0b1024;
    --terminal-text: #e7e8f4;
    --sans: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  .container {
    width: min(100% - 40px, 1120px);
    margin-inline: auto;
  }

  header {
    position: sticky;
    z-index: 10;
    top: 0;
    border-bottom: 1px solid var(--border);
    background: rgba(252, 251, 248, 0.92);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
  }

  nav {
    display: flex;
    gap: 28px;
    font-family: var(--mono);
    font-size: 12px;
  }

  nav a,
  .footer-links a {
    color: var(--text-secondary);
  }

  nav a:hover,
  nav a:focus-visible,
  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--text);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(420px, 0.92fr);
    gap: clamp(48px, 7vw, 88px);
    align-items: center;
    min-height: 700px;
    padding-block: 104px;
  }

  .overline {
    margin: 0 0 18px;
    color: var(--text-secondary);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--green);
    vertical-align: 1px;
  }

  h1 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(54px, 6.2vw, 78px);
    font-weight: 650;
    letter-spacing: -0.052em;
    line-height: 1.02;
  }

  .lede {
    max-width: 620px;
    margin: 28px 0 0;
    color: var(--text-secondary);
    font-size: 20px;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    min-height: 43px;
    align-items: center;
    justify-content: center;
    padding: 0 17px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
  }

  .button.primary {
    border-color: var(--blue);
    background: var(--blue);
    color: white;
  }

  .button.primary:hover,
  .button.primary:focus-visible {
    border-color: var(--blue-dark);
    background: var(--blue-dark);
  }

  .button.secondary {
    gap: 9px;
    background: var(--surface);
  }

  .button.secondary:hover,
  .button.secondary:focus-visible {
    border-color: var(--text-secondary);
  }

  .stack-map {
    overflow: hidden;
    border: 1px solid #31365f;
    border-radius: 12px;
    background: var(--terminal);
    color: var(--terminal-text);
    box-shadow: 0 18px 45px rgba(11, 16, 36, 0.18);
    font-family: var(--mono);
  }

  .stack-map-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid #292e50;
    color: #9ca1bd;
    font-size: 10px;
  }

  .stack-map-dots {
    color: var(--coral);
    font-size: 7px;
    letter-spacing: 4px;
  }

  .stack-map-body {
    padding: 16px 22px;
  }

  .stack-line {
    display: grid;
    grid-template-columns: 76px 18px minmax(92px, 1fr) 18px 78px;
    gap: 6px;
    align-items: center;
    padding-block: 14px;
    border-bottom: 1px solid #252a49;
    font-size: 11px;
  }

  .stack-line:last-child {
    border-bottom: 0;
  }

  .stack-node,
  .stack-result {
    color: #9298b5;
  }

  .stack-node::before {
    color: #555c82;
    content: "[";
  }

  .stack-node::after {
    color: #555c82;
    content: "]";
  }

  .stack-line strong {
    color: #f7f1e7;
    font-weight: 600;
  }

  .stack-arrow {
    color: var(--cyan);
    text-align: center;
  }

  .stack-result {
    text-align: right;
  }

  .stack-map-footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-top: 1px solid #292e50;
    color: #777e9f;
    font-size: 9px;
  }

  .projects-section {
    padding-block: 100px 112px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .section-intro {
    display: grid;
    grid-template-columns: 180px minmax(0, 660px);
    gap: 44px;
    align-items: start;
  }

  .section-intro h2,
  .cta h2 {
    margin: 0;
    font-size: clamp(34px, 4.5vw, 48px);
    font-weight: 650;
    letter-spacing: -0.042em;
    line-height: 1.12;
  }

  .section-intro > div > p {
    max-width: 590px;
    margin: 18px 0 0;
    color: var(--text-secondary);
    font-size: 18px;
  }

  .project-list {
    margin-top: 68px;
    border-top: 1px solid var(--border-strong);
  }

  .project {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) 170px;
    gap: 30px;
    padding-block: 40px;
    border-bottom: 1px solid var(--border);
  }

  .project-meta,
  .project-link {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    font-family: var(--mono);
    font-size: 10px;
  }

  .project-meta > span:first-child {
    color: var(--text-secondary);
  }

  .project-meta > span:last-child {
    color: var(--blue);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project-status {
    padding: 3px 7px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-secondary);
  }

  .project-content {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(200px, 0.72fr);
    gap: 48px;
  }

  .project h3 {
    margin: -6px 0 10px;
    font-family: var(--mono);
    font-size: clamp(26px, 3vw, 36px);
    letter-spacing: -0.045em;
  }

  .project-content p {
    max-width: 510px;
    margin: 0;
    color: var(--text-secondary);
  }

  .project ul {
    margin: 0;
    padding: 0;
    color: var(--text-secondary);
    font-size: 14px;
    list-style: none;
  }

  .project li {
    position: relative;
    padding: 3px 0 3px 17px;
  }

  .project li::before {
    position: absolute;
    left: 0;
    color: var(--blue);
    content: "→";
    font-family: var(--mono);
  }

  .project-link {
    align-items: flex-end;
    text-align: right;
  }

  .project-link > span {
    color: var(--text-secondary);
  }

  .project-link a {
    color: var(--blue);
  }

  .project-link a:hover,
  .project-link a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .about {
    padding-block: 112px 124px;
  }

  .thesis {
    display: flex;
    min-height: 190px;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-top: 68px;
    padding: 34px 38px;
    border: 1px solid #31365f;
    border-radius: 12px;
    background:
      radial-gradient(circle at 80% 0%, rgba(88, 83, 216, 0.28), transparent 38%),
      var(--terminal);
    color: var(--terminal-text);
  }

  .thesis p {
    max-width: 620px;
    margin: 0;
    font-size: clamp(30px, 4.2vw, 48px);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .thesis span {
    max-width: 230px;
    color: #aeb3ca;
    font-family: var(--mono);
    font-size: 11px;
  }

  .values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 22px;
  }

  .values article {
    min-height: 265px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .values code {
    color: var(--blue);
    font-family: var(--mono);
    font-size: 11px;
  }

  .values h3 {
    margin: 62px 0 12px;
    font-size: 20px;
    letter-spacing: -0.025em;
  }

  .values p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
  }

  .toolchain {
    display: flex;
    justify-content: space-between;
    gap: 26px;
    margin-top: 22px;
    padding: 20px 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-secondary);
    font-family: var(--mono);
    font-size: 11px;
  }

  .toolchain strong {
    color: var(--text);
    font-weight: 600;
  }

  .cta {
    position: relative;
    padding-block: 92px;
    overflow: hidden;
    border-top: 1px solid #31365f;
    background: var(--terminal);
    color: var(--terminal-text);
  }

  .cta::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--cyan) 0 58%,
      var(--blue) 58% 82%,
      var(--coral) 82%
    );
    content: "";
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
  }

  .cta .overline {
    color: #9298b5;
  }

  .cta-inner > div:first-child > p:last-child {
    max-width: 580px;
    margin: 18px 0 0;
    color: #aeb3ca;
    font-size: 16px;
  }

  .cta-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
  }

  .button.cta-primary {
    gap: 8px;
    border-color: var(--coral);
    background: var(--coral);
    color: #16172a;
  }

  .button.cta-primary:hover,
  .button.cta-primary:focus-visible {
    border-color: #ff746a;
    background: #ff746a;
  }

  .button.cta-secondary {
    border-color: #484e72;
    color: #c9ccdb;
  }

  .button.cta-secondary:hover,
  .button.cta-secondary:focus-visible {
    border-color: #747b9d;
    color: white;
  }

  footer {
    padding-block: 36px;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 160px 1fr auto auto;
    gap: 40px;
    align-items: center;
    color: var(--text-secondary);
    font-family: var(--mono);
    font-size: 10px;
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 22px;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .stack-map {
      max-width: 620px;
    }

    .project {
      grid-template-columns: 90px minmax(0, 1fr);
    }

    .project-link {
      grid-column: 2;
      flex-direction: row;
      align-items: center;
      text-align: left;
    }

    .values {
      grid-template-columns: 1fr;
    }

    .values article {
      min-height: auto;
    }

    .values h3 {
      margin-top: 38px;
    }

    .thesis {
      align-items: flex-start;
