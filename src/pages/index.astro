---
import Brand from "../components/Brand.astro";

const products = [
  {
    index: "01",
    name: "ffbpe",
    scope: "tokenization",
    status: "available",
    summary:
      "Fast and faithful byte-pair encoding for training exact tokenizers over large, multilingual corpora.",
    points: [
      "Python + Rust APIs",
      "Exact bounded-memory training",
      "Tiktoken-compatible encoding",
    ],
    language: "Rust / Python",
    href: "https://github.com/tokn-ai/ffbpe",
  },
  {
    index: "02",
    name: "flm.py",
    scope: "training",
    status: "research preview",
    summary:
      "A composable Python workspace for language-model research, training, reinforcement learning, and inference.",
    points: ["PyTorch foundations", "Reusable model modules", "Portable training experiments"],
    language: "Python",
    href: "https://github.com/tokn-ai/flm.py",
  },
  {
    index: "03",
    name: "tokn-router",
    scope: "inference",
    status: "in development",
    summary:
      "One local, OpenAI-compatible endpoint for supported coding plans and model providers.",
    points: ["Single Rust binary", "Streaming + account pools", "Local SQLite usage records"],
    language: "Rust",
    href: "https://github.com/agentic-rs/tokn",
  },
  {
    index: "04",
    name: "llm-tokei",
    scope: "usage",
    status: "available",
    summary:
      "Fast, local reports that show where your coding-agent tokens and estimated costs went.",
    points: ["Six agent sources", "Human tables + stable JSON", "No log uploads"],
    language: "Rust",
    href: "https://github.com/agentic-rs/llm-tokei",
  },
];

const showcases = [
  {
    name: "ffbpe",
    scope: "tokenization",
    title: "Shape a multilingual inventory before training.",
    description:
      "A measured release benchmark showing the effect of retained Unicode bigrams on one FineWeb2 Chinese workload.",
    image: "/showcase/ffbpe.png",
    alt: "FFBPE training benchmark comparing regular and retained-bigram Unicode inventories.",
    href: "https://github.com/tokn-ai/ffbpe",
  },
  {
    name: "flm.py",
    scope: "training",
    title: "Compose a complete model experiment.",
    description:
      "Datasets, reusable modules, training, reinforcement learning, and inference remain visible parts of one workspace.",
    image: "/showcase/flm-py.png",
    alt: "FLM experiment configuration beside its composable package workflow.",
    href: "https://github.com/tokn-ai/flm.py",
  },
  {
    name: "tokn-router",
    scope: "inference",
    title: "Route one local endpoint across providers.",
    description:
      "An account-aware gateway handles compatible clients, provider selection, streaming, and local request state.",
    image: "/showcase/tokn-router.png",
    alt: "Tokn Router diagram connecting an OpenAI-compatible client to providers and local state.",
    href: "https://github.com/agentic-rs/tokn",
  },
  {
    name: "llm-tokei",
    scope: "usage",
    title: "Report where agent tokens went.",
    description:
      "A representative grouped usage report across local coding-agent sources, models, token classes, and cost.",
    image: "/showcase/llm-tokei.png",
    alt: "LLM Tokei sample usage table grouped by coding agent and model.",
    href: "https://github.com/agentic-rs/llm-tokei",
  },
];
---

<!doctype html>
<html lang="en">
