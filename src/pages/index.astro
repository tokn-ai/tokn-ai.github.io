---
import Brand from "../components/Brand.astro";

const site_title = "Tokn AI — Open tools for agents and models";
const site_description =
  "Browse agent conversations, manage local and remote terminals, and build model infrastructure with open-source tools from Tokn AI.";

const products = [
  {
    id: "tokn-session",
    name: "tokn-session",
    scope: "agent sessions",
    status: "in development",
    summary:
      "Bring conversations from different agent tools and machines into one searchable view, with native details preserved.",
    points: [
      "Six agent sources",
      "Desktop + web viewer",
      "Encrypted access across machines",
    ],
    language: "Rust / TypeScript",
    href: "https://github.com/tokn-ai/tokn-session",
    showcase: {
      title: "Pick up the thread across agent tools.",
      description:
        "Find past conversations in one place. Browse sessions from Codex, Pi, OpenCode, ZCode, WorkBuddy, and DSH, with live interactions where the provider supports them.",
      image: "/showcase/tokn-session.png",
      alt: "Six agent sources feed a shared session layer and a searchable desktop and web viewer.",
    },
  },
  {
    id: "ctl",
    name: "ctl",
    scope: "terminal control",
    status: "in development",
    summary:
      "Keep terminal sessions running and manage work across local and SSH-connected machines from a CLI or desktop app.",
    points: [
      "Persistent sessions + split panes",
      "Reusable task definitions",
      "Local + SSH connections",
    ],
    language: "Rust / TypeScript",
    href: "https://github.com/tokn-ai/ctl",
    showcase: {
      title: "Come back to the same running terminals.",
      description:
        "Reconnect to persistent shells across local and SSH hosts. Use the CLI to start tasks, check their status, and inspect logs.",
      image: "/showcase/ctl.png",
      alt: "CLI and desktop access to persistent local and SSH terminal sessions, with a separate CLI task workflow.",
    },
  },
  {
    id: "tokn",
    name: "tokn",
    scope: "model routing",
    status: "in development",
    summary:
      "Route compatible clients through one local endpoint, with provider selection, streaming, and account pools.",
    points: [
      "OpenAI-compatible endpoint",
      "Streaming + account pools",
      "Local SQLite usage records",
    ],
    language: "Rust",
    href: "https://github.com/tokn-ai/tokn",
    showcase: {
      title: "Connect your client to the models you use.",
      description:
        "A local gateway handles compatible requests, provider routing, streaming, and request history.",
      image: "/showcase/tokn-router.png",
      alt: "A local Tokn gateway connects an OpenAI-compatible client to providers and local request records.",
    },
  },
  {
    id: "llm-tokei",
    name: "llm-tokei",
    scope: "usage reports",
    status: "available",
    summary:
      "See where coding-agent tokens and estimated costs went, using session records already on your machine.",
    points: [
      "Reports across coding agents",
      "Human tables + stable JSON",
      "Local session analysis",
    ],
    language: "Rust",
    href: "https://github.com/agentic-rs/llm-tokei",
    showcase: {
      title: "See what your agent work adds up to.",
      description:
        "Group local usage by agent and model to compare token classes and estimated costs. The sample report shows the shape of the output.",
      image: "/showcase/llm-tokei.png",
      alt: "A sample usage table groups coding-agent tokens and estimated costs by source and model.",
    },
  },
  {
    id: "ffbpe",
    name: "ffbpe",
    scope: "tokenization",
    status: "available",
    summary:
      "Train exact byte-pair tokenizers over large, multilingual corpora with bounded memory and compatible encoding.",
    points: [
      "Python, Rust + WebAssembly",
      "Exact bounded-memory training",
      "Tiktoken-compatible encoding",
    ],
    language: "Rust / Python",
    href: "https://github.com/tokn-ai/ffbpe",
    showcase: {
      title: "Shape a multilingual inventory before training.",
      description:
        "A measured release benchmark shows how retained Unicode bigrams affect one FineWeb2 Chinese workload.",
      image: "/showcase/ffbpe.png",
      alt: "FFBPE training benchmark comparing regular and retained-bigram Unicode inventories.",
    },
  },
  {
    id: "flm-py",
    name: "flm.py",
    scope: "model research",
    status: "research preview",
    summary:
      "Compose language-model experiments from reusable modules for datasets, training, reinforcement learning, and inference.",
    points: [
      "PyTorch foundations",
      "Reusable model modules",
      "Portable training experiments",
    ],
    language: "Python",
    href: "https://github.com/tokn-ai/flm.py",
    showcase: {
      title: "Build a model experiment from reusable parts.",
      description:
        "Follow the configuration from datasets and model modules through training, reinforcement learning, and inference.",
      image: "/showcase/flm-py.png",
      alt: "FLM experiment configuration beside its composable package workflow.",
    },
  },
];

const showcases = products.map(({ name, scope, href, showcase }) => ({
  name,
  scope,
  href,
  ...showcase,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={site_description}
    />
    <meta name="theme-color" content="#fcfbf8" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="canonical" href="https://tokn-ai.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tokn AI" />
    <meta
      property="og:title"
      content={site_title}
    />
    <meta
      property="og:description"
      content={site_description}
    />
    <meta property="og:url" content="https://tokn-ai.dev/" />
    <meta property="og:image" content="https://tokn-ai.dev/og.png" />
    <meta
      property="og:image:alt"
      content="Tokn AI — Open tools for agents and models."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={site_title}
    />
    <meta
      name="twitter:description"
      content={site_description}
    />
    <meta name="twitter:image" content="https://tokn-ai.dev/og.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{site_title}</title>
  </head>

  <body>
    <header>
      <div class="container header-inner">
        <Brand />
        <nav aria-label="Primary navigation">
          <a href="#showcase">Showcase</a>
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
          <a href="https://github.com/tokn-ai" target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero container">
        <div class="hero-copy">
          <p class="overline">
            <span class="status-dot" aria-hidden="true"></span> Open source lab
          </p>
          <h1>Open tools for working with agents.</h1>
          <p class="lede">
            Browse conversations across agent tools. Keep local and remote
            terminals running. Build on open components for routing, usage,
            and model research.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#tokn-session">Explore tokn-session</a>
            <a class="button secondary" href="#ctl">
              Explore ctl <span aria-hidden="true">↘</span>
            </a>
          </div>
        </div>

        <aside class="stack-map" aria-label="Find a project by task">
          <div class="stack-map-header">
            <span>tokn-ai / projects</span>
            <span class="stack-map-dots" aria-hidden="true">● ● ●</span>
          </div>
          <div class="stack-map-body">
            {
              products.map((product) => (
                <a class="stack-line" href={`#${product.id}`}>
                  <span class="stack-node">{product.scope}</span>
                  <strong>{product.name}</strong>
                  <span class="stack-arrow" aria-hidden="true">↘</span>
                </a>
              ))
            }
          </div>
        </aside>
      </section>

      <section class="showcase-section" id="showcase">
        <div class="container">
          <div class="section-intro">
            <p class="overline">Showcase</p>
            <div>
              <h2>A closer look at the tools.</h2>
              <p>
                Start with a shared view of your agent sessions and terminals.
                Explore the tools for routing, usage, and model research.
              </p>
            </div>
          </div>

          <div
            class="showcase-carousel"
            data-carousel
            role="region"
            aria-roledescription="carousel"
            aria-label="Project showcases"
          >
            <div class="showcase-toolbar">
              <p class="showcase-position" aria-live="polite">
                <span data-carousel-position>01</span>
                <span aria-hidden="true"> / </span>
                <span class="sr-only">of</span>
                <span>{String(showcases.length).padStart(2, "0")}</span>
              </p>
              <div class="showcase-controls">
                <button
                  type="button"
                  data-carousel-previous
                  aria-label="Show previous project"
                >
                  <span aria-hidden="true">←</span>
                </button>
                <button
                  type="button"
                  data-carousel-next
                  aria-label="Show next project"
                >
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>

            <div
              class="showcase-viewport"
              data-carousel-viewport
              tabindex="0"
            >
              <div class="showcase-track">
                {
                  showcases.map((showcase, index) => (
                    <article
                      class="showcase-card"
                      id={`showcase-slide-${index}`}
                      data-carousel-slide
                      role="group"
                      aria-roledescription="slide"
                      aria-label={`${index + 1} of ${showcases.length}: ${showcase.name}`}
                    >
                      <a
                        class="showcase-image"
                        href={showcase.href}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={`Open the ${showcase.name} repository`}
                      >
                        <img
                          src={showcase.image}
                          width="1200"
                          height="720"
                          loading="lazy"
                          decoding="async"
                          alt={showcase.alt}
                        />
                      </a>
                      <div class="showcase-copy">
                        <div class="showcase-meta">
                          <span>{showcase.scope}</span>
                          <span>{showcase.name}</span>
                        </div>
                        <h3>{showcase.title}</h3>
                        <p>{showcase.description}</p>
                        <a href={showcase.href} target="_blank" rel="noreferrer">
                          View repository <span aria-hidden="true">↗</span>
                        </a>
                      </div>
                    </article>
                  ))
                }
              </div>
            </div>

            <div class="showcase-dots" aria-label="Choose a project showcase">
              {
                showcases.map((showcase, index) => (
                  <button
                    type="button"
                    data-carousel-dot
                    data-index={index}
                    aria-controls={`showcase-slide-${index}`}
                    aria-label={`Show ${showcase.name}`}
                    aria-current={index === 0 ? "true" : undefined}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="projects-section" id="projects">
        <div class="container">
          <div class="section-intro">
            <p class="overline">Open projects</p>
            <div>
              <h2>Find the part you need.</h2>
              <p>
                Each project has its own job. Follow a repository for setup
                instructions, current capabilities, and development progress.
              </p>
            </div>
          </div>

          <div class="project-list">
            {
              products.map((product) => (
                <article class="project" id={product.id}>
                  <div class="project-meta">
                    <span>{product.scope}</span>
                  </div>
                  <div class="project-content">
                    <div>
                      <h3>{product.name}</h3>
                      <p>{product.summary}</p>
                    </div>
                    <ul>
                      {product.points.map((point) => <li>{point}</li>)}
                    </ul>
                  </div>
                  <div class="project-link">
                    <span class="project-status">{product.status}</span>
                    <a href={product.href} target="_blank" rel="noreferrer">
                      {product.language} <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="about container" id="about">
        <div class="section-intro">
          <p class="overline">About the lab</p>
          <div>
            <h2>Useful tools, open foundations.</h2>
            <p>
              Tokn AI builds tools for the work around agents and models, from
              finding a conversation to keeping a remote terminal running or
              training a tokenizer.
            </p>
          </div>
        </div>

        <div class="thesis">
          <p>Start with the problem in front of you.</p>
          <span>Browse the code, run a tool, and make it part of your workflow.</span>
        </div>

        <div class="values">
          <article>
            <h3>Choose what fits.</h3>
            <p>
              Use a session viewer, a terminal tool, or a research library on
              its own. Each project documents its interfaces and setup.
            </p>
          </article>
          <article>
            <h3>See how it works.</h3>
            <p>
              Read the source and follow the decisions behind each tool.
              Repositories make capabilities and limitations visible.
            </p>
          </article>
          <article>
            <h3>Build on shared work.</h3>
            <p>
              Report a rough edge, contribute a fix, or reuse a component.
              Practical feedback helps the tools improve with the work.
            </p>
          </article>
        </div>

        <div class="toolchain" aria-label="Primary technologies">
          <span><strong>Rust</strong> / durable systems</span>
          <span><strong>TypeScript</strong> / product surfaces</span>
          <span><strong>Python</strong> / model research</span>
        </div>
      </section>

      <section class="cta">
        <div class="container cta-inner">
          <div>
            <p class="overline">Get involved</p>
            <h2>Find a tool. Make it yours.</h2>
            <p>
              Read the docs, try a project, or share what would make it more
              useful. Development happens in the open on GitHub.
            </p>
          </div>
          <div class="cta-actions">
            <a
              class="button cta-primary"
              href="https://github.com/tokn-ai"
              target="_blank"
              rel="noreferrer"
            >
              Explore GitHub <span aria-hidden="true">↗</span>
            </a>
            <a class="button cta-secondary" href="#projects">Browse projects</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <Brand />
        <p>Open tools for agents and models.</p>
        <div class="footer-links">
          <a href="#projects">Projects</a>
          <a href="https://github.com/tokn-ai" target="_blank" rel="noreferrer">GitHub</a>
        </div>
        <span>© 2026</span>
      </div>
    </footer>

    <script>
      const carousels =
        document.querySelectorAll<HTMLElement>("[data-carousel]");
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      carousels.forEach((carousel) => {
        const viewport = carousel.querySelector<HTMLElement>(
          "[data-carousel-viewport]",
        );
        const slides = Array.from(
          carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"),
        );
        const dots = Array.from(
          carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"),
        );
        const position = carousel.querySelector<HTMLElement>(
          "[data-carousel-position]",
        );
        const previous = carousel.querySelector<HTMLButtonElement>(
          "[data-carousel-previous]",
        );
        const next = carousel.querySelector<HTMLButtonElement>(
          "[data-carousel-next]",
        );

        if (!viewport || slides.length === 0) {
          return;
        }

        let activeIndex = 0;

        const updateActiveSlide = (index: number) => {
          activeIndex = index;

          if (position) {
            position.textContent = String(index + 1).padStart(2, "0");
          }

          dots.forEach((dot, dotIndex) => {
            if (dotIndex === index) {
              dot.setAttribute("aria-current", "true");
            } else {
              dot.removeAttribute("aria-current");
            }
          });
        };

        const showSlide = (index: number) => {
          const normalizedIndex =
            (index + slides.length) % slides.length;
          const slide = slides[normalizedIndex];
          const left = slide.offsetLeft - slides[0].offsetLeft;

          viewport.scrollTo({
            left,
            behavior: prefersReducedMotion.matches ? "auto" : "smooth",
          });
          updateActiveSlide(normalizedIndex);
        };

        previous?.addEventListener("click", () => {
          showSlide(activeIndex - 1);
        });

        next?.addEventListener("click", () => {
          showSlide(activeIndex + 1);
        });

        dots.forEach((dot) => {
          dot.addEventListener("click", () => {
            const index = Number(dot.dataset.index);
            if (Number.isInteger(index)) {
              showSlide(index);
            }
          });
        });

        viewport.addEventListener("keydown", (event) => {
          if (event.key === "ArrowLeft") {
            event.preventDefault();
            showSlide(activeIndex - 1);
          }

          if (event.key === "ArrowRight") {
            event.preventDefault();
            showSlide(activeIndex + 1);
          }
        });

        let scrollSettleTimer: number | undefined;

        viewport.addEventListener("scroll", () => {
          window.clearTimeout(scrollSettleTimer);
          scrollSettleTimer = window.setTimeout(() => {
            const closestIndex = slides.reduce(
              (closest, slide, index) => {
                const currentDistance = Math.abs(
                  slide.offsetLeft -
                    slides[0].offsetLeft -
                    viewport.scrollLeft,
                );
                const closestDistance = Math.abs(
                  slides[closest].offsetLeft -
                    slides[0].offsetLeft -
                    viewport.scrollLeft,
                );

                return currentDistance < closestDistance
                  ? index
                  : closest;
              },
              0,
            );

            updateActiveSlide(closestIndex);
          }, 100);
        });
      });
    </script>

  </body>
</html>

<style>
  :root {
    --background: #fcfbf8;
    --surface: #ffffff;
    --surface-subtle: #f5f3ef;
    --text: #2e2935;
    --text-secondary: #645d69;
    --border: #e0dfdc;
    --border-strong: #bcbcc2;
    --plum: #6a5a7d;
    --plum-light: #7d6b91;
    --plum-dark: #574768;
    --teal-dark: #2c706a;
    --teal: #61b6af;
    --orange: #c48257;
    --terminal: #231f2a;
    --terminal-border: #45404d;
    --terminal-muted: #ad9fb8;
    --terminal-text: #ece7ef;
    --sans: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  .container {
    width: min(100% - 40px, 1120px);
    margin-inline: auto;
  }

  header {
    position: sticky;
    z-index: 10;
    top: 0;
    border-bottom: 1px solid var(--border);
    background: rgba(252, 251, 248, 0.92);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
  }

  nav {
    display: flex;
    gap: 28px;
    font-family: var(--mono);
    font-size: 12px;
  }

  nav a,
  .footer-links a {
    color: var(--text-secondary);
  }

  nav a:hover,
  nav a:focus-visible,
  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--text);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(420px, 0.92fr);
    gap: clamp(48px, 7vw, 88px);
    align-items: center;
    min-height: 700px;
    padding-block: 104px;
  }

  .overline {
    margin: 0 0 18px;
    color: var(--text-secondary);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--orange);
    vertical-align: 1px;
  }

  h1 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(54px, 6.2vw, 78px);
    font-weight: 650;
    letter-spacing: -0.052em;
    line-height: 1.02;
  }

  .lede {
    max-width: 620px;
    margin: 28px 0 0;
    color: var(--text-secondary);
    font-size: 20px;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    min-height: 43px;
    align-items: center;
    justify-content: center;
    padding: 0 17px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
  }

  .button.primary {
    border-color: var(--plum);
    background: var(--plum);
    color: white;
  }

  .button.primary:hover,
  .button.primary:focus-visible {
    border-color: var(--plum-dark);
    background: var(--plum-dark);
  }

  .button.secondary {
    gap: 9px;
    background: var(--surface);
  }

  .button.secondary:hover,
  .button.secondary:focus-visible {
    border-color: var(--text-secondary);
  }

  .stack-map {
    overflow: hidden;
    border: 1px solid var(--terminal-border);
    border-radius: 12px;
    background: var(--terminal);
    color: var(--terminal-text);
    box-shadow: 0 18px 45px rgb(35 31 42 / 18%);
    font-family: var(--mono);
  }

  .stack-map-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid #3b3544;
    color: var(--terminal-muted);
    font-size: 10px;
  }

  .stack-map-dots {
    color: var(--teal);
    font-size: 7px;
    letter-spacing: 4px;
  }

  .stack-map-body {
    padding: 16px 22px;
  }

  .stack-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content 12px;
    gap: 16px;
    align-items: center;
    padding-block: 14px;
    border-bottom: 1px solid #3b3544;
    font-size: 11px;
  }

  .stack-line:last-child {
    border-bottom: 0;
  }

  .stack-line:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 4px;
  }

  .stack-line:hover strong,
  .stack-line:focus-visible strong {
    color: var(--teal);
  }

  .stack-node {
    color: var(--terminal-muted);
  }

  .stack-line strong {
    color: var(--terminal-text);
    font-weight: 600;
  }

  .stack-arrow {
    color: var(--teal);
    text-align: center;
  }

  .showcase-section {
    padding-block: 104px 112px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface-subtle);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
