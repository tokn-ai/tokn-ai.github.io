          </p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">Explore projects</a>
            <a
              class="button secondary"
              href="https://github.com/tokn-ai"
              target="_blank"
              rel="noreferrer"
            >
              View source <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="stack-map" aria-label="Tokn AI open project stack">
          <div class="stack-map-header">
            <span>tokn-ai / open_stack</span>
            <span class="stack-map-dots" aria-hidden="true">● ● ●</span>
          </div>
          <div class="stack-map-body">
            <div class="stack-line">
              <span class="stack-node">corpus</span>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <strong>ffbpe</strong>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <span class="stack-result">tokens</span>
            </div>
            <div class="stack-line">
              <span class="stack-node">tokens</span>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <strong>flm.py</strong>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <span class="stack-result">model</span>
            </div>
            <div class="stack-line">
              <span class="stack-node">request</span>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <strong>tokn-router</strong>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <span class="stack-result">inference</span>
            </div>
            <div class="stack-line">
              <span class="stack-node">traces</span>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <strong>llm-tokei</strong>
              <span class="stack-arrow" aria-hidden="true">→</span>
              <span class="stack-result">usage</span>
            </div>
          </div>
          <div class="stack-map-footer">
            <span>open core</span>
            <span>composable</span>
            <span>hosted when useful</span>
          </div>
        </div>
      </section>

      <section class="showcase-section" id="showcase">
        <div class="container">
          <div class="section-intro">
            <p class="overline">Showcase</p>
            <div>
              <h2>Foundations in practice.</h2>
              <p>
                Representative outputs from the current public projects. Each
                one solves a different shared problem beneath AI products.
              </p>
            </div>
          </div>

          <div
            class="showcase-carousel"
            data-carousel
            role="region"
            aria-roledescription="carousel"
            aria-label="Project showcases"
          >
            <div class="showcase-toolbar">
              <p class="showcase-position" aria-live="polite">
                <span data-carousel-position>01</span>
                <span aria-hidden="true"> / </span>
                <span class="sr-only">of</span>
                <span>{String(showcases.length).padStart(2, "0")}</span>
              </p>
              <div class="showcase-controls">
                <button
                  type="button"
                  data-carousel-previous
                  aria-label="Show previous project"
                >
                  <span aria-hidden="true">←</span>
                </button>
                <button
                  type="button"
                  data-carousel-next
                  aria-label="Show next project"
                >
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>

            <div
              class="showcase-viewport"
              data-carousel-viewport
              tabindex="0"
            >
              <div class="showcase-track">
                {
                  showcases.map((showcase, index) => (
                    <article
                      class="showcase-card"
                      id={`showcase-slide-${index}`}
                      data-carousel-slide
                      role="group"
                      aria-roledescription="slide"
                      aria-label={`${index + 1} of ${showcases.length}: ${showcase.name}`}
