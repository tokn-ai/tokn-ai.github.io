---
import SiteLayout from "../layouts/SiteLayout.astro";
import Navbar from "./design/Navbar.astro";
import { apell_copy } from "../i18n/apell";
import { getLocalizedPath, type Locale } from "../i18n/locales";

interface Props { locale: Locale }

const { locale } = Astro.props;
const copy = apell_copy[locale];
const path = "/appell/";
const icon = "/appell/icon.png";
const repository = "https://github.com/agentic-rs/apell";
const setup = `${repository}#first-run`;
const guide = `${repository}#package-and-distribute`;
const api = `${repository}/blob/main/docs/architecture.md`;
const alternate_locale = locale === "en" ? "zh-CN" : "en";
---

<SiteLayout {locale} {path} title={copy.title} description={copy.description} og_image={icon} og_alt={copy.og_alt}>
  <Navbar
    {locale}
    product={{ name: "Apell", href: getLocalizedPath(locale, path) }}
    links={[{ label: copy.overview, href: "#main" }, { label: copy.developers, href: "#developers" }]}
    repository_href={repository}
    alternate={{
      label: locale === "en" ? "中文" : "EN",
      href: getLocalizedPath(alternate_locale, path),
      lang: alternate_locale,
      accessible_label: copy.switch_language,
    }}
  />
  <main class="apell" id="main">
    <section class="intro" aria-labelledby="intro-title">
      <div class="tokn-shell hero">
        <div class="hero-copy">
          <p class="wordmark"><img src={icon} alt="" width="42" height="42" />Apell</p>
          <h1 id="intro-title">{copy.headline} <em>{copy.emphasis}</em></h1>
          <p class="description">{copy.intro}</p>
          <div class="actions">
            <a class="tokn-button build" href={setup}>{copy.build_apell} <span aria-hidden="true">↗</span></a>
            <a class="tokn-button write" href="#developers">{copy.build_applet} <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <figure class="preview">
          <div class="scene" aria-hidden="true">
            <div class="device launcher">
              <div class="device-bar"><strong>Apell</strong><span aria-hidden="true">＋　⚙</span></div>
              <div class="launcher-grid">
                {copy.launcher_applets.map((label, index) => (
                  <div class="launcher-item">
                    <div class:list={["tile", { "tile-companion": index === 0 }]}>{["◒", "¶"][index]}</div>
                    <span>{label}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="device companion">
              <div class="device-bar"><strong>Companion</strong><span aria-hidden="true">···　×</span></div>
              <div class="chat">
                <p class="chat-title">{copy.recent_chat}</p>
                <p class="message question">{copy.chat_question}</p>
                <p class="message answer"><span class="chat-avatar">◒</span><span>{copy.chat_answer}</span></p>
                <div class="composer"><span>{copy.chat_placeholder}</span><span class="send">↑</span></div>
              </div>
            </div>
          </div>
          <figcaption>{copy.preview_caption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="tokn-shell features" aria-labelledby="features-title">
      <h2 id="features-title">{copy.features_title}</h2>
      <dl>
        {copy.features.map(feature => (
          <div>
            <dt>{feature.name}</dt>
            <dd>{feature.detail}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="developer" id="developers" aria-labelledby="developer-title">
      <div class="tokn-shell developer-inner">
        <div class="developer-copy">
          <h2 id="developer-title">{copy.developer_title}</h2>
          <p>{copy.developer_detail}</p>
          <div class="developer-links">
            <a class="tokn-link" href={guide}>{copy.guide} <span aria-hidden="true">↗</span></a>
            <a class="tokn-link" href={api}>{copy.api} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <figure class="package">
          <figcaption>{copy.package_label}</figcaption>
          <ul>
            <li><code>manifest.json</code></li>
            <li><code>index.html</code></li>
            <li><code>assets/</code></li>
            <li><code>lib/main.wasm</code><span>{copy.package_optional}</span></li>
          </ul>
        </figure>
      </div>
    </section>
  </main>
  <footer class="tokn-shell tokn-signature">
    <a class="tokn-link" href={getLocalizedPath(locale)}><span aria-hidden="true">←</span> {copy.back}</a>
    <a class="tokn-link" href={repository}>{copy.source} <span aria-hidden="true">↗</span></a>
  </footer>
</SiteLayout>

<style>
  .apell {
    --apell-dark: #211c2b;
    --apell-panel: #30283b;
    --apell-text: #f7f3fa;
    --apell-ink: #252030;
    --apell-teal: #61b6af;
    --apell-plum: #6a5a7d;
    --apell-violet: #7d6b91;
    --apell-orange: #d77a36;
    --apell-canvas: #f8f7fa;
    --apell-surface: #fff;
    --apell-subtle: #f0edf4;
    --apell-muted-light: #595062;
    --apell-muted-dark: #cfc5db;
    --apell-rule: #dfd7e7;
    --apell-rule-dark: var(--apell-violet);
    background: var(--apell-canvas);
    color: var(--apell-ink);
  }
  .apell :focus-visible { outline-color: var(--apell-plum); }
  .intro { background: var(--apell-dark); color: var(--apell-text); }
  .intro :focus-visible { outline-color: var(--apell-teal); }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 5vw, 76px);
    padding-block: clamp(50px, 8vw, 108px);
  }
  .wordmark { display: flex; align-items: center; gap: 12px; font-size: 20px; font-weight: 650; }
  .wordmark img { display: block; border: 1px solid var(--apell-rule-dark); border-radius: 12px; }
  h1 {
    margin-block: 28px 22px;
    font-size: clamp(3.3rem, 6.3vw, 6.1rem);
    font-weight: 550;
    line-height: .98;
    letter-spacing: -.075em;
  }
  h1 em {
    display: block;
    color: var(--apell-teal);
    font-family: var(--tokn-serif);
    font-weight: 400;
    letter-spacing: -.065em;
  }
  :global(html:lang(zh-CN)) h1 { font-size: clamp(2.65rem, 5.3vw, 5.6rem); line-height: 1.16; letter-spacing: -.05em; }
  :global(html:lang(zh-CN)) h1 em { font-style: normal; letter-spacing: inherit; }
  .description { max-width: 32rem; color: var(--apell-muted-dark); font-size: clamp(1rem, 1.5vw, 1.2rem); text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .build, .build:hover { background: var(--apell-teal); color: var(--apell-ink); }
  .write { border-color: var(--apell-rule-dark); background: transparent; color: var(--apell-text); }
  .write:hover { background: var(--apell-panel); }

  .preview { min-width: 0; }
  .scene {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1.08;
    overflow: hidden;
    container-type: inline-size;
    border: 1px solid var(--apell-rule-dark);
    border-radius: 28px;
    background:
      radial-gradient(ellipse at 30% 20%, color-mix(in srgb, var(--apell-violet) 45%, transparent), transparent 65%),
      repeating-linear-gradient(90deg, transparent 0 39px, #f7f3fa0b 40px 41px),
      repeating-linear-gradient(0deg, transparent 0 39px, #f7f3fa0b 40px 41px),
      var(--apell-panel);
  }
  .scene::after {
    position: absolute;
    top: 7%;
    right: 8%;
    width: 7px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--apell-orange);
    content: "";
  }
  .device {
    position: absolute;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 3.1cqw;
    border: 1px solid var(--apell-rule-dark);
    border-radius: 5cqw;
    box-shadow: 0 16px 50px #17121f70;
    font-size: 2.8cqw;
    line-height: 1.52;
  }
  .device-bar { display: flex; align-items: center; justify-content: space-between; gap: 1cqw; }
  .device-bar strong { font-size: 3.4cqw; line-height: 1.4; }
  .device-bar > span { font-size: 2.8cqw; white-space: nowrap; }
  .launcher {
    top: 11%;
    bottom: 17%;
    left: 8%;
    width: 49%;
    border-color: var(--apell-rule);
    background: var(--apell-canvas);
    color: var(--apell-ink);
    transform: rotate(-6deg);
  }
  .launcher-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1cqw; margin-top: 5cqw; }
  .launcher-item { display: flex; flex-direction: column; align-items: center; gap: 1.2cqw; font-size: 1.9cqw; text-align: center; }
  .tile {
    display: grid;
    place-content: center;
    width: 8.8cqw;
    height: 8.8cqw;
    border: 1px solid var(--apell-rule);
    border-radius: 2.6cqw;
    background: var(--apell-subtle);
    font-size: 4.2cqw;
    line-height: 1;
  }
  .tile-companion { background: var(--apell-teal); }
  .companion {
    inset: 27% 8% 9% 39%;
    background: var(--apell-dark);
    color: var(--apell-text);
    transform: rotate(5deg);
  }
  .chat { display: flex; flex: 1; flex-direction: column; justify-content: flex-end; gap: 1.6cqw; min-height: 0; margin-top: 2.4cqw; }
  .chat-title { margin-bottom: auto; color: var(--apell-muted-dark); font-size: 2.2cqw; }
  .message { font-size: 2.55cqw; }
  .question { max-width: 83%; align-self: flex-end; padding: 1.6cqw 2cqw; border-radius: 2.5cqw 2.5cqw .5cqw 2.5cqw; background: var(--apell-panel); }
  .answer { display: flex; gap: 1.4cqw; color: var(--apell-muted-dark); }
  .chat-avatar, .send { display: grid; place-items: center; flex: none; width: 4cqw; height: 4cqw; border-radius: 50%; background: var(--apell-teal); color: var(--apell-ink); font-weight: 650; }
  .composer { display: flex; justify-content: space-between; align-items: center; padding: 1.2cqw 1.4cqw; border: 1px solid var(--apell-rule-dark); border-radius: 2.6cqw; color: var(--apell-muted-dark); font-size: 2.3cqw; }
  .preview figcaption { margin-top: 10px; color: var(--apell-muted-dark); font-size: 12px; text-align: center; }

  .features { padding-block: clamp(45px, 7vw, 90px); }
  h2 { font-size: clamp(2rem, 4vw, 3.35rem); font-weight: 550; letter-spacing: -.052em; line-height: 1.12; text-wrap: balance; }
  :global(html:lang(zh-CN)) h2 { letter-spacing: -.02em; line-height: 1.25; }
  .features dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 4vw, 54px); margin: 32px 0 0; }
  .features dl > div { padding-top: 20px; border-top: 1px solid var(--apell-rule); }
  .features dt { font-size: 1.06rem; font-weight: 650; }
  .features dd, .developer-copy > p { margin: 8px 0 0; color: var(--apell-muted-light); text-wrap: pretty; }
  .developer { background: var(--apell-subtle); }
  .developer-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .65fr); align-items: center; gap: clamp(24px, 8vw, 104px); padding-block: clamp(42px, 7vw, 82px); }
  .developer-copy > p { margin-top: 18px; }
  .developer-links { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 10px; }
  .developer-links a { color: var(--apell-plum); }
  .package { padding: clamp(16px, 3vw, 28px); border: 1px solid var(--apell-rule); border-radius: 16px; background: var(--apell-surface); }
  .package figcaption { margin-bottom: 11px; font-size: 13px; font-weight: 650; }
  .package ul { margin: 0; padding: 0; list-style: none; }
  .package li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding-block: 7px; border-top: 1px solid var(--apell-rule); color: var(--apell-muted-light); font-size: 13px; }
  .package code { color: var(--apell-ink); }

  @media (max-width: 760px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .preview { width: min(100%, 35rem); margin-inline: auto; }
    .features dl, .developer-inner { grid-template-columns: minmax(0, 1fr); }
    .package { width: min(100%, 35rem); }
  }
  @media (max-width: 400px) {
    .actions { gap: 8px; }
    .actions a { gap: .65rem; padding-inline: .75rem; }
    .scene { border-radius: 20px; }
  }
</style>
