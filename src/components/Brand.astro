---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a class:list={["brand", className]} href="/" aria-label="Tokn AI home">
  <img src="/logo.svg" width="118" height="32" alt="" />
</a>

<style>
  .brand {
    display: inline-flex;
    justify-self: start;
  }
</style>
