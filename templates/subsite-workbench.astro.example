---
// OPTIONAL composition study, not a required page structure.
// Copy to src/components/subsites/WorkbenchPage.astro, then import it from a route.
// Replace the example name, URLs, copy and proof with your product's own material.
// Create both language routes before enabling a language-switch destination.
import SiteLayout from "../../layouts/SiteLayout.astro";
import Navbar from "../design/Navbar.astro";
import { getLocalizedPath, type Locale } from "../../i18n/locales";

interface Props { locale: Locale }
const { locale } = Astro.props;
const path = "/example/";
const name = "project";
const home_href = `https://tokn-ai.dev${getLocalizedPath(locale)}`;
const copy = locale === "en" ? {
  title: "A clear product promise.",
  emphasis: "With room to explore.",
  description: "Name the tool, the task it helps with, and the useful result. Keep the opening specific enough to understand without a demo.",
  category: "A tool from the Tokn workshop",
  explore: "See it in action",
  source: "Explore the source",
  proof: "Example output · replace with real product proof",
  note: "One small action. A useful result.",
  next: "Then tell the story your product needs.",
  detail: "A workflow, a comparison, an API example, a screenshot, or nothing else yet. The shared identity comes from the typography, colors, spacing, and small details—not a mandatory section sequence.",
} : {
  title: "一个清楚的产品承诺。",
  emphasis: "留一点探索空间。",
  description: "说清楚这是怎样的工具、帮助完成什么任务，以及带来什么结果。即使不操作演示，也能理解它的用途。",
  category: "来自 Tokn 工坊的工具",
  explore: "看看实际效果",
  source: "探索源码",
  proof: "示例输出 · 请替换成真实的产品展示",
  note: "一个小动作，一个有用的结果。",
  next: "接着，讲产品自己的故事。",
  detail: "工作流程、对比、API 示例、截图，或者暂时到此为止。共同的气质来自字体、颜色、留白和小细节，不需要相同的章节顺序。",
};
---

<SiteLayout body_class="tokn-site" locale={locale} path={path} title={`${name} — Tokn AI`} description={copy.description} og_image={locale === "en" ? "/og.png" : "/og-cn.png"} og_alt={copy.title}>
  <Navbar
    locale={locale}
    home_href={home_href}
    product={{ name, href: getLocalizedPath(locale, path) }}
    links={[
      { label: copy.explore, href: "#proof" },
      { label: locale === "en" ? "About" : "关于", href: "#story" },
    ]}
    repository_href="https://github.com/tokn-ai"
    alternate={{
      label: locale === "en" ? "中文" : "EN",
      href: getLocalizedPath(locale === "en" ? "zh-CN" : "en", path),
      lang: locale === "en" ? "zh-CN" : "en",
      accessible_label: locale === "en" ? "切换到简体中文" : "Switch to English",
    }}
  />
  <main id="main">
    <section class="tokn-shell workbench-opening" aria-labelledby="page-title">
      <div>
        <p class="tokn-kicker"><span aria-hidden="true">↳</span> {copy.category}</p>
        <h1 id="page-title">{copy.title}<br /><em>{copy.emphasis}</em></h1>
        <p class="opening-description">{copy.description}</p>
        <a class="tokn-link" href="https://github.com/tokn-ai">{copy.source} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="proof-scene" id="proof">
        <p class="margin-note">{copy.note} <span aria-hidden="true">↴</span></p>
        <slot name="proof">
          <figure class="example-output">
            <figcaption>{copy.proof}</figcaption>
            <pre tabindex="0"><code>example task
  inspect     complete
  compare     ready
  next step   yours</code></pre>
          </figure>
        </slot>
      </div>
    </section>
    <!-- This freely written section is disposable; the starter has no content schema. -->
    <section class="tokn-shell next-chapter" id="story" aria-labelledby="next-title">
      <span class="chapter-mark" aria-hidden="true">✳</span>
      <div><h2 id="next-title">{copy.next}</h2><p>{copy.detail}</p></div>
    </section>
  </main>
  <footer class="tokn-shell starter-footer"><a class="tokn-link" href={home_href}>← Tokn AI</a><span>{locale === "en" ? "Open-source wheels for RSI." : "为 RSI 造开源轮子。"}</span></footer>
</SiteLayout>

<style>
  .starter-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 25px; border-top: 1px solid var(--tokn-line); color: var(--tokn-muted); font: 10px/1.6 var(--tokn-mono); }
  .workbench-opening { display: grid; grid-template-columns: .9fr 1.1fr; align-items: center; gap: 64px; padding-block: 85px 100px; }
  .tokn-kicker > span { color: var(--tokn-orange); font-size: 24px; }
  h1 { margin-top: 25px; font-size: clamp(42px, 5vw, 72px); line-height: 1.06; font-weight: 500; letter-spacing: -.055em; }
  h1 em { color: var(--tokn-teal-ink); font-family: var(--tokn-serif); font-weight: 400; }
  .opening-description { max-width: 440px; margin-top: 27px; color: var(--tokn-muted); font-size: 16px; line-height: 1.8; }
  .workbench-opening .tokn-link { margin-top: 25px; }
  .proof-scene { min-width: 0; }
  .margin-note { margin-bottom: 20px; color: var(--tokn-plum); text-align: right; font: italic 18px/1.5 var(--tokn-serif); transform: rotate(-3deg); }
  .margin-note > span { margin-left: 12px; color: var(--tokn-orange); font-size: 28px; }
  .example-output { margin: 0; overflow: hidden; border: 1px solid #48414f; border-radius: 14px; background: #242028; color: #eee8f2; box-shadow: 0 22px 45px -25px #30293760; }
  .example-output figcaption { padding: 15px 22px; border-bottom: 1px solid #48414f; color: #bdb2c8; font: 10px/1.6 var(--tokn-mono); }
  .example-output pre { overflow-x: auto; margin: 0; padding: 35px 28px 65px; color: #a6d4c9; font: 13px/2.5 var(--tokn-mono); }
  .example-output code { font: inherit; }
  .next-chapter { display: grid; grid-template-columns: 100px 1fr; gap: 45px; padding-block: 60px 90px; border-top: 1px solid var(--tokn-line); }
  .chapter-mark { color: var(--tokn-orange); font-size: 70px; line-height: 1; transform: rotate(-12deg); }
  h2 { max-width: 690px; font-size: clamp(30px, 3.5vw, 46px); font-weight: 500; letter-spacing: -.04em; line-height: 1.2; }
  .next-chapter p { max-width: 640px; margin-top: 25px; color: var(--tokn-muted); font-size: 16px; line-height: 1.8; }
  :global(html:lang(zh-CN)) h1 { letter-spacing: -.03em; line-height: 1.2; }
  :global(html:lang(zh-CN)) h1 em { font-family: "Songti SC", "STSong", serif; font-style: normal; }
  :global(html:lang(zh-CN)) .margin-note { font-family: "Kaiti SC", "KaiTi", serif; font-style: normal; }
  @media (max-width: 900px) {
    .workbench-opening { grid-template-columns: 1fr; gap: 42px; padding-block: 45px 65px; }
    h1 { max-width: 670px; font-size: clamp(42px, 8vw, 70px); }
    .opening-description { max-width: 580px; }
    .next-chapter { grid-template-columns: 65px 1fr; gap: 25px; padding-block: 45px 65px; }
    .chapter-mark { font-size: 52px; }
  }
  @media (max-width: 600px) {
    .starter-footer { flex-wrap: wrap; gap: 8px 20px; }
    .workbench-opening { gap: 30px; padding-block: 32px 45px; }
    h1 { font-size: 42px; }
    .opening-description, .next-chapter p { font-size: 14px; }
    .margin-note { font-size: 14px; }
    .example-output figcaption { padding-inline: 16px; font-size: 9px; }
    .example-output pre { padding: 24px 16px 40px; font-size: 11px; }
    .next-chapter { grid-template-columns: 1fr; gap: 20px; }
    .chapter-mark { font-size: 37px; }
  }
</style>
